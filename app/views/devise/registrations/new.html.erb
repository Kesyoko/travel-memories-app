<div class="max-w-md mx-auto mt-10 p-6 bg-white rounded-lg shadow-md">
  <h2 class="text-2xl font-moji text-center mb-6">新規登録</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-4" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :email, "メールアドレス", class: "block text-sm font-moji text-gray-700" %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", 
          class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring focus:border-blue-300" %>
    </div>

    <div>
      <%= f.label :password, "パスワード", class: "block text-sm font-moji text-gray-700" %>
      <% if @minimum_password_length %>
        <em class="text-sm text-gray-500 font-moji">（<%= @minimum_password_length %>文字以上）</em>
      <% end %>
      <%= f.password_field :password, autocomplete: "new-password",class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm
          focus:outline-none focus:ring focus:border-blue-300" %>
    </div>

    <div>
      <%= f.label :password_confirmation, "パスワード（確認用）", class: "block text-sm font-moji text-gray-700" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password",
        class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring focus:border-blue-300" %>
    </div>

    <div>
      <%= f.submit "登録する",
        class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm
                 text-sm font-moji text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring focus:ring-blue-300" %>
    </div>
  <% end %>

    <div class="mt-4 text-center">
      <div class="inline-block w-full py-2 px-4 bg-blue-600 text-white rounded-md shadow hover:bg-blue-200 transition font-moji">
        <%= render "devise/shared/links" %>
      </div>
    </div>
</div>
