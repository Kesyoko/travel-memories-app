<%- if controller_name != 'sessions' %>
  <%= link_to "ログイン", new_session_path(resource_name) %><br />
<% end %>

<% if devise_mapping.registerable? && controller_name != 'registrations' %>
  <div class="mt-4 text-center">
    <%= link_to "新規会員登録", new_registration_path(resource_name), class: "w-full flex inline-block px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 transition" %>
  </div>
<% end %>



<%
=begin %>
<%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
  <%= link_to "Forgot your password?", new_password_path(resource_name) %><br />
<% end %>
<%
=end %>

<%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
  <%= link_to "Didn't receive confirmation instructions?", new_confirmation_path(resource_name) %><br />
<% end %>


<%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
  <%= link_to "Didn't receive unlock instructions?", new_unlock_path(resource_name) %><br />
<% end %>


<div>または</div>

<div class="mt_4">
  <%= button_to omniauth_authorize_path(resource_name,:google_oauth2),
      data: { turbo: false },
      class: "w-full flex justify-center py-2 px-4 border border-transparent rounded-md shadow-sm text-sm font-moji text-white bg-red-500 hover:bg-red-600" do %>
        Googleでログイン
  <% end %>
</div>


