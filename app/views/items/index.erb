
 <%# turboデフォオンなので切る%>

<div class="max-w-xl mx-auto px-4 py-6 bg-white shadow rounded space-y-6 font-moji">
<h2 class="text-2xl font-semibold border-b pb-2 text-gray-800">
<%= @travel_record.travel_date%>の持ち物
</h2>

<%# 既存持ち物表示ゾーン%>
<% @items.each do |item| %>
  <%# 空だったら無視%>
  <% next if item.id.nil? %>
  <div class="flex items-center gap-4">

    <%# ペケ更新ゾーン%>
    <%# local: trueは非同期通信を行わないために必要。また、モデルは親と子を記載。%>
    <%= form_with model: [@travel_record, item], 
        method: :patch,
        local: true,
        data: { turbo: false } do |f| %>
      <%= f.check_box :is_checked %>
      <span><%= item.name %></span>
      <%# 送信%>
      <%= f.submit "変更",
      class: "rounded-md bg-green-600 px-2  text-siro shadow hover:bg-green-700 active:scale-95 transition-all duration-300" %>
    <% end %>

    <%# 持ち物削除%>
    <%= button_to '削除',
    travel_record_item_path(@travel_record, item),
    method: :delete,
    data: { turbo: false },
    class: "text-red-600 rounded-md bg-red-600 px-2  text-siro shadow hover:bg-red-700 active:scale-95 transition-all duration-300" %>



  </div>

  <div>
    <%= item.memo %>
  </div>
<% end %>

<%# 新規追加ゾーン%>

<%= form_with scope: :item,
              url: travel_record_items_path(@travel_record),
              local: true,
              data: { turbo: false } do |f| %>  
  <div class="flex  items-center gap-4">

    <div>
      <%= f.label :name, "持ち物名", class: "block text-lg font-moji text-gray-700 mb-1 hidden" %>
      <%= f.text_field :name,placeholder: "持ち物名", class: "w-full px-4 py-2 border-b border-gray-300  focus:outline-none focus:ring focus:ring-blue-200" %>
    </div>

  </div>

  <div>
    <%= f.label :memo, "メモ", class: "block text-lg font-moji text-gray-700 mb-1" %> 
    <%= f.text_area :memo, rows: 4, class: "max-w-md px-4 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring focus:ring-blue-200 " %> 
  </div>


  <div class="pt-4">
    <%= f.submit "保存する", class: "mx-auto block rounded-md bg-neutral-950 px-5 py-2.5 text-siro font-semibold hover:bg-neutral-800 transition-all duration-300 active:scale-95" %>
  </div>
</div>

<% end %> 