<!DOCTYPE html>
<html lang="ja">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NZ72XYRVCK"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-NZ72XYRVCK');
    </script>

    <!-- タグ表示（ページごとに変化しない） -->
    <title><%=  "記すたび" %></title>
    
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <!-- OGPを表示するためタグ設定 -->
    <%= display_meta_tags(default_meta_tags) %>
    
    <%= yield :head %>

    <!-- ファビコンを設定するための記述とショートカット作成マニフェスト -->
    <%= favicon_link_tag "favicon.ico" %>
    <link rel="manifest" href="/manifest.json">
    <link rel="apple-touch-icon" href="/1travel_logo.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>

    <!-- グーグル住所オートコンプリート 参考記事ではビューに書いていたが新規登録や編集ページなどで扱うためこちらに記述 -->
    <!-- scriptタグで何を使うか判断している -->
    <script src="https://maps.googleapis.com/maps/api/js?key=<%= ENV['MAPS_API_KEY'] %>&libraries=places"></script>
  </head>

  <body class="min-h-screen flex flex-col">

  <%# ローディングアニメーション設定%>
  <div data-controller="loading" class="min-h-screen flex flex-col">
    <div data-loading-target="anime" class="fixed inset-0 z-50 flex items-center justify-center bg-midori bg-opacity-40 hidden">
      <div class="h-[150px] w-[150px] flex items-center justify-center">
        <div class="loader"></div>
      </div>
    </div>
  
    <%= render "travel_records/header" %>

    <main class="flex-1 pt-8">
      <%= yield %>
    </main>
  
  <%= render "travel_records/footer" %>
  
  </div>
 </body>
</html>