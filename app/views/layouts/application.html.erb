<!DOCTYPE html>
<html lang="ja">
  <head>
    <title><%= content_for(:title) || "Myapp" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <!-- OGPを表示するためタグ設定 -->
    <%= display_meta_tags(default_meta_tags) %>
    
    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class=" flex flex-col min-h-screen">

  <div data-controller="loading">
  <div data-loading-target="anime" class="fixed inset-0 z-50 flex items-center justify-center bg-midori bg-opacity-40 hidden">
    <div class="h-[150px] w-[150px] flex items-center justify-center">
      <div class="loader"></div>
    </div>
  </div>
    <%= render "travel_records/header" %>

    <div class="flex-grow pt-8">
      <%= yield %>
    </div>
  

  <footer class="footer pt-4">
   <%= render "travel_records/footer" %>
  </footer>
 </body>
</html>