<h1 class="text-4xl font-bold mb-8 text-center font-moji">
  <%= params[:date] %> の記録一覧
</h1>
<!-- 以下は公式を参考にしたもの -->
<div class="max-w-3xl mx-auto px-4 py-6 bg-white shadow rounded space-y-4 font-moji">
<!-- 背景にグレーを適用してポップアップ出てますよを演出 -->
<dialog id="share-dialog" class="p-0 rounded-md">
  <div id="backdrop"
       class="fixed inset-0 bg-black/40 flex items-center justify-center">

    <!-- モーダル(クリックしたらイベント発生するようonClickもつける) -->
    <div class="bg-white rounded-lg shadow-xl w-full max-w-lg font-moji p-6"
         onclick="event.stopPropagation()">
      <!-- ユーザーへのメッセージ -->
      <h3 class="text-lg font-semibold text-gray-900 mb-4">
        このURLを共有したい人に送信してください
      </h3>
      <!-- URL表示ゾーン -->
      <input id="share-url" type="text" readonly
             value="<%= shearing_url(@shared_link.token) %>"
             class="w-full border border-gray-300 rounded p-2 bg-gray-50 text-gray-700 mb-4">

      <div class="flex justify-end gap-2">
        <button onclick="copyUrl()"
                class="bg-green-700 hover:bg-midori text-siro font-bold py-2 px-4 rounded font-moji">
          URLをコピーする
        </button>

        <button onclick="closeDialog()"
                class="bg-gray-400 hover:bg-gray-500 text-siro font-bold py-2 px-4 rounded font-moji">
          閉じる
        </button>
      </div>

    </div>
  </div>
</dialog>

<div class="mb-8 flex justify-center flex gap-4 ">

<button command="show-modal" commandfor="share-dialog"
        class="bg-midori hover:bg-green-600 text-siro font-bold py-2 px-4 rounded font-moji">
  記録共有
</button>

  <%= link_to '一覧に戻る', travel_records_path,
    class: "rounded-md bg-gray-600 px-6 py-2.5 text-white  shadow font-moji
            hover:bg-gray-700 active:scale-95 transition-all duration-300" %>   
  </div>

  <% @travel_records.sort.reverse.each do |record| %>
    <div class="p-6 border rounded-lg shadow bg-white  transition space-y-4">
      <h2 class="text-2xl  border-b pb-2 text-gray-800"><%= record.title %></h2>

      <div>
        <h3 class="text-lg font-moji text-gray-700">場所</h3>
        <p class="text-base text-gray-900"><%= record.place_name %></p>
      </div>

      <div>
        <h3 class="text-lg font-moji text-gray-700">所在地</h3>
        <p class="text-base text-gray-900"><%= record.address %></p>
      </div>

      <div>
        <h3 class="text-lg font-moji text-gray-700">メモ</h3>
        <p class="text-base text-gray-900 whitespace-pre-line"><%= record.memo %></p>
      </div>

      <div>
        <h3 class="text-lg text-gray-700">主な交通手段</h3>
        <p class="text-base text-gray-900"><%= t("enums.travel_record.transportation.#{record.transportation}") %></p>
      </div>

      <div>
      <h3 class="text-lg font-moji text-gray-700">また行きたい？</h3>
      <p class="text-base text-gray-900">
        <%= record.want_to_visit_again ? "行きたい！" : "今回で満足" %>
      </p>
    </div>

      <% if record.travel_images.attached? %>
      <div>
        <h3 class="text-lg font-moji text-gray-700">写真</h3>
        <div class="flex flex-wrap gap-4 mt-2">
          <% record.travel_images.each do |image| %>
            <%= image_tag image, class: "w-64 h-auto rounded shadow" %>
          <% end %>
        </div>
      </div>
    <% end %>

      <div class="flex gap-4 font-moji">
        <%= link_to '編集', edit_travel_record_path(record),
            class: "rounded-md bg-green-600 px-4 py-2 text-white shadow hover:bg-green-700 transition" %>

        <%= link_to '削除', travel_record_path(record),
            data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
            class: "rounded-md bg-red-600 px-4 py-2 text-white shadow hover:bg-red-700 transition" %>
      </div>
    </div>
  <% end %>
</div>

<script>
  const dialog = document.getElementById('share-dialog');
  const backdrop = document.getElementById('backdrop');

  backdrop.addEventListener('click', () => {
    dialog.close();
  });
  // 背景のグレーを押しても消えますよという挙動
  document.querySelector('[command="show-modal"]').addEventListener('click', () => {
    dialog.showModal();
  });

  function closeDialog() {
    dialog.close();
  }
  // thenは上手く行った時、catchは失敗した時の処理
  function copyUrl() {
    const url = document.getElementById('share-url').value;
    navigator.clipboard.writeText(url)
      .then(() => alert('コピーしました'))
      .catch(() => alert('コピーに失敗しました'));
  }
</script>
