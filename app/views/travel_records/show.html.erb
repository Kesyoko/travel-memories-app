<h1 class="text-4xl font-bold mb-6 text-center font-moji">記録詳細ページ</h1>

<div class="max-w-3xl mx-auto px-4 py-6 bg-white shadow rounded space-y-6 font-moji">

  <h2 class="text-2xl font-semibold border-b pb-2 text-gray-800"><%= @travel_record.title %></h2>

  <div class="space-y-4">
    <div>
      <h3 class="text-lg font-moji text-gray-700">場所</h3>
      <p class="text-base text-gray-900"><%= @travel_record.place_name %></p>
    </div>

    <div>
      <h3 class="text-lg font-moji text-gray-700">所在地</h3>
      <p class="text-base text-gray-900"><%= @travel_record.address %></p>
    </div>
    
    <div>
      <h3 class="text-lg font-moji text-gray-700">メモ</h3>
      <p class="text-base text-gray-900 whitespace-pre-line"><%= @travel_record.memo %></p>
    </div>

    <div>
      <h3 class="text-lg font-moji text-gray-700">訪れた日</h3>
      <p class="text-base text-gray-900"><%= @travel_record.travel_date %></p>
    </div>

    <div>
      <h3 class="text-lg text-gray-700">主な交通手段</h3>
      <p class="text-base text-gray-900"><%= t("enums.travel_record.transportation.#{@travel_record.transportation}") %></p>
    </div>
    

    <div>
      <h3 class="text-lg font-moji text-gray-700">また行きたい？</h3>
      <p class="text-base text-gray-900">
        <%= @travel_record.want_to_visit_again ? "行きたい！" : "うーん…" %>
      </p>
    </div>

    <% if @travel_record.travel_images.attached? %>
      <div>
        <h3 class="text-lg font-moji text-gray-700">写真</h3>
        <div class="flex flex-wrap gap-4 mt-2">
          <% @travel_record.travel_images.each do |image| %>
            <%= image_tag image, class: "w-64 h-auto rounded shadow" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="flex flex-wrap gap-4 pt-6">
      <%= link_to '編集する', edit_travel_record_path(@travel_record),
        class: "rounded-md bg-neutral-950 px-5 py-2.5 text-siro hover:bg-neutral-800 transition-all duration-300" %>

      <%= link_to '← 戻る', travel_records_path,
        class: "rounded-md bg-gray-500 px-5 py-2.5 text-siro hover:bg-gray-700 transition-all duration-300" %>

      <%= link_to '記録削除', travel_record_path(@travel_record),
        data: { turbo_method: :delete, turbo_confirm: "削除しますか？" },
        class: "bg-red-500 hover:bg-red-700 text-siro font-bold py-2 px-4 rounded transition-all duration-300" %>
    </div>
  </div>
</div>
